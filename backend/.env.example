# Server
PORT=5000
NODE_ENV=development
APP_TIMEZONE=Asia/Dhaka
FRONTEND_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://admin:changeme@localhost:27017/autopilot?authSource=admin

# Auth
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!
TOKEN_ENCRYPTION_KEY=32-byte-hex-or-random-string-here!!

# Gemini (free tier OK for text; video/Veo needs paid billing)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.5-flash
GEMINI_VIDEO_MODEL=veo-3.0-generate-001
VIDEO_PROVIDER=auto
GEMINI_TEMPERATURE=0.7

# Hugging Face (free monthly credits cover cheap/fast video models; auto-switches models+providers)
HF_API_KEY=
HF_VIDEO_MODEL=Lightricks/LTX-Video-0.9.8-13B-distilled
HF_VIDEO_MODELS=Lightricks/LTX-Video-0.9.8-13B-distilled,Wan-AI/Wan2.1-T2V-1.3B,tencent/HunyuanVideo

# Meta / Facebook
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5000/api/facebook/oauth/callback
META_GRAPH_VERSION=v21.0
META_SCOPES=pages_manage_posts,pages_read_engagement,pages_show_list

# Redis / Queues (optional — backend runs jobs inline when false; no worker needed)
REDIS_URL=
QUEUE_PREFIX=autopilot
USE_QUEUE=false

# Storage
STORAGE_PROVIDER=local
STORAGE_DIR=../storage
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Limits
MAX_VIDEOS_PER_DAY=2
MAX_VIDEO_GENERATIONS_PER_DAY=4
MAX_AI_REQUESTS_PER_DAY=100

# FFmpeg (optional explicit path, e.g. a winget install not on PATH)
FFMPEG_PATH=
FFPROBE_PATH=

# Frontend (public)
NEXT_PUBLIC_API_URL=http://localhost:5000
